# OpenAI-compatible native-mask image-edit endpoint.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=replace_me
IMAGE_MODEL=gpt-image-2
IMAGE_FIELD=image[]
IMAGE_API_TRANSPORT=multipart
IMAGE_API_AUTH_SCHEME=Bearer
IMAGE_ROUTE_HEADER_NAME=
IMAGE_ROUTE_HEADER_VALUE=
IMAGE_TIMEOUT_SECONDS=600

# WaveSpeed SAM3 semantic segmentation.
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_API_KEY=replace_me

# Local application.
SIMPLE_FILL_HOST=127.0.0.1
SIMPLE_FILL_PORT=7862
SIMPLE_FILL_WORKERS=3
SIMPLE_FILL_DATA=./data
MAX_UPLOAD_MIB=200
MAX_IMAGE_PIXELS=120000000
